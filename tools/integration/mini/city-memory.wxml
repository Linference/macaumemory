<view class="memory-page"><view class="hero"><text class="eyebrow">MACAU MEMORY</text><text class="title">从眼前的建筑
走进澳门的故事</text><text class="intro">{{counts.places}} 个建筑档案 · {{counts.photos}} 张实拍照片</text><button class="plan" bindtap="onPlan">文化探索清单 · {{selectedIds.length}}</button></view><input class="search" placeholder="搜索建筑或类型" bindinput="onSearch"/><view class="grid"><view class="card" wx:for="{{places}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelect"><image class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="card-body"><text class="category">{{item.categoryName}}</text><text class="name">{{item.name}}</text><text class="count">{{item.photoCount}} 张真实照片 · 查看记忆 →</text></view></view></view><view wx:if="{{!places.length}}" class="empty">没有匹配的建筑</view>
<view class="mask" wx:if="{{selected}}"><scroll-view scroll-y class="detail"><button class="close" bindtap="onClose">关闭</button><text class="category">{{selected.categoryName}} · {{selected.memoryId}}</text><text class="title">{{selected.name}}</text><text class="summary">{{selected.summary}}</text><view class="actions"><button bindtap="onMap">地图定位</button><button bindtap="onAddPlan">加入探索清单</button></view><text class="gallery-title">精选实拍 · 档案共 {{selected.photoCount}} 张</text><view wx:for="{{selected.gallery}}" wx:key="image" class="photo"><image src="{{item.image}}" mode="widthFix" data-image="{{item.image}}" bindtap="onPreview"/><text class="credit">{{item.taken || '日期未记录'}} · {{item.credit}}</text><button wx:if="{{item.sourcePage}}" data-url="{{item.sourcePage}}" bindtap="onCopySource" class="source">复制照片来源</button></view></scroll-view></view></view>
