page{background:#f5f2eb;color:#244d46}.memory-page{padding:30rpx}.hero{padding:28rpx 0 35rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#9c7b37;display:block}.title{font-size:42rpx;font-weight:600;display:block;line-height:1.5;margin:18rpx 0;white-space:pre-line}.intro{font-size:25rpx;color:#718279}.plan{background:#244d46;color:white;border-radius:14rpx;font-size:26rpx;margin-top:25rpx}.search{background:white;border:1rpx solid #dce0d3;border-radius:14rpx;padding:22rpx;font-size:27rpx;margin-bottom:25rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.card{background:white;border:1rpx solid #e0e2d6;border-radius:20rpx;overflow:hidden}.cover{width:100%;height:220rpx}.card-body{padding:20rpx}.category{display:block;color:#9c7b37;font-size:21rpx}.name{display:block;font-size:29rpx;font-weight:600;margin:12rpx 0}.count{font-size:20rpx;color:#718279}.empty{text-align:center;padding:70rpx}.mask{position:fixed;inset:0;background:#172821a0;z-index:50;display:flex;align-items:flex-end}.detail{max-height:88vh;background:#f5f2eb;border-radius:30rpx 30rpx 0 0;box-sizing:border-box;padding:35rpx}.close{margin:0 0 20rpx auto;width:130rpx;font-size:24rpx;color:#244d46}.summary{display:block;font-size:27rpx;line-height:1.85}.actions{display:flex;gap:20rpx;margin:25rpx 0}.actions button{flex:1;background:#244d46;color:#fff;font-size:26rpx}.gallery-title{font-size:26rpx;display:block;margin:30rpx 0}.photo{margin-bottom:35rpx}.photo image{width:100%;border-radius:15rpx}.credit{font-size:21rpx;color:#718279;display:block;line-height:1.6;margin-top:12rpx}.source{font-size:22rpx;background:transparent;color:#244d46;margin:12rpx 0}
